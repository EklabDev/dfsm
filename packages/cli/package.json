{
  "name": "dfsm-cli",
  "version": "0.1.0",
  "description": "CLI for @eklabdev/dfsm: lint, compile, migrate, viz",
  "type": "module",
  "bin": {
    "dfsm": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@eklabdev/dfsm": "workspace:*",
    "commander": "^12.0.0",
    "dfsm-viz": "workspace:*",
    "mongodb": "^6.0.0",
    "tsx": "^4.0.0",
    "chalk": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0",
    "zod": "^3.22.0"
  }
}
