{
  "name": "@eklabdev/dfsm",
  "version": "0.1.0",
  "description": "Core durable finite state machine library",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "mongodb": "^6.0.0",
    "zod": "^3.22.0",
    "zod-to-ts": "^1.2.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^9.0.0",
    "vitest": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
