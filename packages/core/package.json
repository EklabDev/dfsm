{
  "name": "@eklabdev/dfsm",
  "version": "0.2.0",
  "description": "Durable finite state machines with provider-agnostic persistence and queue-driven execution",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EklabDev/dfsm.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/EklabDev/dfsm/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/EklabDev/dfsm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.0.0",
    "pg": "^8.13.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "mongodb-memory-server": "^9.0.0",
    "vitest": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
