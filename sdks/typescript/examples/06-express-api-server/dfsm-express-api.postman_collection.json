    {
      "name": "5. Conditional Effect Router & Automatic Next Transition",
      "description": "Demonstrates `@DfsmEffect` acting as an `if / else` router (`req.runEffect`) with direct `req.actor` access (`await req.actor.transition(...)`) so `SUBMIT_ORDER` with `autoApprovePayment: true` automatically chains straight from `created` -> `inventory_reserved` -> `fulfilling`!",
      "item": [
        {
          "name": "01. Create Auto-Approve Order (Auto-Sets {{orderId}})",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderId', 'order-auto-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.transactionId) {",
                  "    pm.collectionVariables.set('orderId', data.transactionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{orderId}}\",\n  \"customerEmail\": \"vip@eklab.dev\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "02. SUBMIT_ORDER with autoApprovePayment=true (Auto-Transitions -> fulfilling!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Auto-transitioned through inventory_reserved straight into parallel fulfilling!', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data.currentState).to.have.property('fulfilling');",
                  "    pm.expect(data.context.paymentAuthId).to.include('express_auto_wallet');",
                  "});",
                  "console.log('Auto-chained currentState:', data.currentState, '| availableEvents:', data.availableEvents);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"SUBMIT_ORDER\",\n  \"input\": {\n    \"autoApprovePayment\": true,\n    \"items\": [\n      {\n        \"sku\": \"VIP-BUNDLE\",\n        \"quantity\": 1,\n        \"unitPriceCents\": 25000\n      }\n    ]\n  }\n}"
            },
            "url": {
