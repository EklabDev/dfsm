{
  "DFSM Machine Scaffold": {
    "prefix": ["dfsm-machine", "dfsm"],
    "description": "Scaffold a complete DFSM v1.0 state machine YAML definition",
    "body": [
      "# yaml-language-server: \\$schema=./schemas/dfsm-v1.schema.json",
      "dfsm: \"1.0\"",
      "id: ${1:order-workflow}",
      "version: \"${2:1.0.0}\"",
      "description: ${3:Durable finite state machine workflow}",
      "initial: ${4:pending}",
      "",
      "registry:",
      "  namespace: \"${5:app.workflow}\"",
      "  strict: true",
      "",
      "defaults:",
      "  retry:",
      "    maxAttempts: ${6:2}",
      "    backoff:",
      "      strategy: exponential",
      "      initialDelayMs: 100",
      "      maxDelayMs: 5000",
      "      multiplier: 2",
      "  onFail:",
      "    compensate: ${7|false,true|}",
      "    target: error",
      "",
      "states:",
      "  ${4:pending}:",
      "    entry: [${8:onEnterPending}]",
      "    on:",
      "      ${9:SUBMIT}:",
      "        target: ${10:completed}",
      "        transition: ${11:submitOrder}",
      "",
      "  ${10:completed}:",
      "    type: final"
    ]
  },
  "DFSM Compound State": {
    "prefix": ["dfsm-compound"],
    "description": "Define a hierarchical compound state with initial child and onDone transition",
    "body": [
      "${1:processing}:",
      "  type: compound",
      "  initial: ${2:step_one}",
      "  entry: [${3:onEnterProcessing}]",
      "  exit: [${4:onExitProcessing}]",
      "  onDone:",
      "    target: ${5:completed}",
      "  states:",
      "    ${2:step_one}:",
      "      on:",
      "        ${6:ADVANCE}:",
      "          target: ${7:done}",
      "          transition: ${8:handleAdvance}",
      "    ${7:done}:",
      "      type: final"
    ]
  },
  "DFSM Parallel State": {
    "prefix": ["dfsm-parallel"],
    "description": "Define an orthogonal parallel state with concurrent child regions and onDone join",
    "body": [
      "${1:fulfilling}:",
      "  type: parallel",
      "  onDone:",
      "    target: ${2:shipped}",
      "    effects: [${3:notifyCompleted}]",
      "  states:",
      "    ${4:billing}:",
      "      initial: ${5:charging}",
      "      states:",
      "        ${5:charging}:",
      "          on:",
      "            ${6:CHARGED}:",
      "              target: ${7:billing_done}",
      "              transition: ${8:capturePayment}",
      "        ${7:billing_done}:",
      "          type: final",
      "    ${9:inventory}:",
      "      initial: ${10:reserving}",
      "      states:",
      "        ${10:reserving}:",
      "          on:",
      "            ${11:RESERVED}:",
      "              target: ${12:inventory_done}",
      "              transition: ${13:reserveStock}",
      "        ${12:inventory_done}:",
      "          type: final"
    ]
  },
  "DFSM Transition Resilience & Saga Policy": {
    "prefix": ["dfsm-policy", "dfsm-resilience"],
    "description": "Configure retry/backoff, circuitBreaker, Saga compensation, and onFail fallback policy on a transition",
    "body": [
      "${1:EXECUTE_STEP}:",
      "  target: ${2:next_state}",
      "  transition: ${3:executeStep}",
      "  compensate: ${4:rollbackStep}",
      "  effects: [${5:emitAuditEvent}]",
      "  retry:",
      "    maxAttempts: ${6:3}",
      "    backoff:",
      "      strategy: ${7|exponential,exponential_jitter,linear,fixed|}",
      "      initialDelayMs: ${8:100}",
      "      maxDelayMs: ${9:5000}",
      "      multiplier: ${10:2}",
      "  circuitBreaker:",
      "    enabled: true",
      "    failureThreshold: ${11:5}",
      "    slidingWindowSize: ${12:10}",
      "    openDurationMs: ${13:30000}",
      "    halfOpenMaxCalls: ${14:1}",
      "  onFail:",
      "    compensate: ${15|true,false|}",
      "    target: ${16:error}"
    ]
  },
  "DFSM Custom Error State Override": {
    "prefix": ["dfsm-error-override", "dfsm-error"],
    "description": "Override the built-in implicit final error state with custom alerting and recovery transitions",
    "body": [
      "error:",
      "  description: ${1:Custom failure handling and recovery state}",
      "  entry: [${2:alertOperations}]",
      "  on:",
      "    ${3:RECOVER}:",
      "      target: ${4:ready}",
      "      transition: ${5:resetFailureContext}"
    ]
  },
  "DFSM Machine Defaults Policy": {
    "prefix": ["dfsm-defaults"],
    "description": "Define machine-wide default retry, circuitBreaker, and onFail policies",
    "body": [
      "defaults:",
      "  retry:",
      "    maxAttempts: ${1:3}",
      "    backoff:",
      "      strategy: ${2|exponential,exponential_jitter,linear,fixed|}",
      "      initialDelayMs: ${3:100}",
      "      maxDelayMs: ${4:5000}",
      "      multiplier: ${5:2}",
      "  circuitBreaker:",
      "    enabled: ${6|false,true|}",
      "    failureThreshold: ${7:5}",
      "    slidingWindowSize: ${8:10}",
      "    openDurationMs: ${9:30000}",
      "    halfOpenMaxCalls: ${10:1}",
      "  onFail:",
      "    compensate: ${11|false,true|}",
      "    target: ${12:error}",
      "  benchmark:",
      "    enabled: true"
    ]
  },
  "DFSM Lifecycle Hooks & Routed Effects": {
    "prefix": ["dfsm-hooks", "dfsm-effects"],
    "description": "Declare transaction lifecycle hooks, routed sub-effects, and maxEffectChainDepth in DFSM YAML",
    "body": [
      "maxEffectChainDepth: ${1:25}",
      "",
      "effects:",
      "  - ${2:routedBranchEffectA}",
      "  - ${3:routedBranchEffectB}",
      "",
      "hooks:",
      "  onStart: ${4:onTransactionStart}",
      "  beforeTransition: ${5:onBeforeTransition}",
      "  afterTransition: ${6:onAfterTransition}",
      "  onCompensate: ${7:onCompensationStep}",
      "  onComplete: ${8:onWorkflowComplete}",
      "  onTerminal: ${9:onTerminalSettled}"
    ]
  }
}
